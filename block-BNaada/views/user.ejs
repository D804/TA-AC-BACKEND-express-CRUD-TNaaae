<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User List</title>
  </head>
  <body>
    <% user.forEach((user)=>{%>
    <div>
      <h2><%=user.name%></h2>
      <h3><%=user._id%></h3>
      <h2><%=user.password%></h2>
    </div>
    <%})%>
  </body>
</html>
