<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User List</title>
  </head>
  <body>
    <div>
      <h2>User List</h2>
      
    </div>
    <% users.forEach((user)=>{%>
    <div>
      <a href="/users/<%=user.id%>"><h2>Name: <%=user.name%></h2></a>

      <h3>Id: <%=user._id%></h3>
      <h2>Password: <%=user.password%></h2>
    </div>
    <%})%>
    <main></main>
  </body>
</html>
