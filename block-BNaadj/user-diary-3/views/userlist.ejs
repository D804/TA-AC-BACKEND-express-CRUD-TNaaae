<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>userlist</title>
  </head>
  <body>
    <%user.forEach((user)=>{%>
    <h2><%=user.name%></h2>
    <h2><%=user.email%></h2>
    <h2><%=user.address%></h2>
    <h2><%=user.hobbies%></h2>
    <h2><%=user.bio%></h2>
    <%})%>
  </body>
</html>
